{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "envVars": {
      "type": "array",
      "description": "Kubernetes EnvVar objects appended to the main container",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        }
      }
    },
    "imageRef": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?$"
    },
    "resourceList": {
      "type": "object",
      "properties": {
        "cpu": {
          "$ref": "#/definitions/quantity"
        },
        "memory": {
          "$ref": "#/definitions/quantity"
        },
        "ephemeral-storage": {
          "$ref": "#/definitions/quantity"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceList"
        },
        "limits": {
          "$ref": "#/definitions/resourceList"
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "scheduling": {
      "properties": {
        "priorityClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "maxSkew",
              "topologyKey",
              "whenUnsatisfiable"
            ]
          }
        },
        "terminationGracePeriodSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
    },
    "priorityClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "value": {
          "type": "integer",
          "maximum": 1000000000
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["", "edge", "default", "large"],
      "description": "GOFI_PROFILE preset for the controller and listener Pods (docs/configuration.md); empty keeps the binary's default"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "leaseName": {
          "type": "string"
        },
        "leaseDuration": {
          "$ref": "#/definitions/duration"
        },
        "renewDeadline": {
          "$ref": "#/definitions/duration"
        },
        "retryPeriod": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "strategy": {
      "type": "object",
      "properties": {
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "podAntiAffinity": {
      "enum": [
        "soft",
        "hard",
        ""
      ]
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable"
        ]
      }
    },
    "priorityClasses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "controlPlane": {
          "$ref": "#/definitions/priorityClass"
        },
        "dataPlane": {
          "$ref": "#/definitions/priorityClass"
        }
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "probes": {
      "$ref": "#/definitions/probes"
    },
    "goRuntime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setMemLimit": {
          "type": "boolean"
        },
        "goMemLimitRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "setMaxProcs": {
          "type": "boolean"
        }
      }
    },
    "image": {
      "allOf": [
        {
          "$ref": "#/definitions/imageRef"
        }
      ],
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "sandboxImage": {
      "allOf": [
        {
          "$ref": "#/definitions/imageRef"
        }
      ],
      "type": "object",
      "required": [
        "repository",
        "tag"
      ]
    },
    "toolingImage": {
      "$ref": "#/definitions/imageRef"
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "llmProxy": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allocateLoadBalancerNodePorts": {
          "type": "boolean"
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadBalancer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allocateNodePorts": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "listenerPodTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "image"
            ]
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "volumeMounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "mountPath"
            ]
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "listenerPods": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/definitions/scheduling"
        }
      ],
      "properties": {
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "priorityClassName": {},
        "nodeSelector": {},
        "tolerations": {},
        "affinity": {},
        "topologySpreadConstraints": {},
        "terminationGracePeriodSeconds": {},
        "extraEnv": {
          "$ref": "#/definitions/envVars"
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/definitions/scheduling"
        }
      ],
      "properties": {
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "priorityClassName": {},
        "nodeSelector": {},
        "tolerations": {},
        "affinity": {},
        "topologySpreadConstraints": {},
        "terminationGracePeriodSeconds": {},
        "extraEnv": {
          "$ref": "#/definitions/envVars"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "libraries": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              }
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "blockMetadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "cidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9.]+/[0-9]+$"
              }
            },
            "ipv6Cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "relay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "scraperNamespaceSelectors": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "extraFrom": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "framing",
          "parser"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "source": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "listen": {
                "type": "object"
              }
            }
          },
          "framing": {
            "type": "object"
          },
          "parser": {
            "type": "object"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "stopped",
              ""
            ]
          }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "description": "Flow revision history (docs/versioning.md)",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Revisions kept per flow"
        },
        "deletedRetention": {
          "type": "string",
          "pattern": "^([0-9]+(h|m|s))+$",
          "description": "How long a deleted flow's history is kept (Go duration)"
        }
      }
    },
    "nodePortRange": {
      "type": "string",
      "pattern": "^$|^[0-9]+-[0-9]+$",
      "description": "NodePort range flow Services may request (min-max); empty means 30000-32767"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "clusterWide": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "manageListeners": {
          "type": "boolean"
        },
        "maxListeners": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "uds": {
      "type": "object",
      "properties": {
        "manageAllows": {
          "type": "boolean"
        },
        "packageBaseConfigMap": {
          "type": "string"
        }
      }
    },
    "alerting": {
      "type": "object",
      "description": "Optional PrometheusRule alerts for flows (requires the Prometheus Operator CRDs).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ruleLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "runbookBaseUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "for": {
          "type": "string"
        },
        "sourceErrorsPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "sinkFailureRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "parseErrorRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "restartsPerHour": {
          "type": "integer",
          "minimum": 1
        },
        "noTrafficFlows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noTrafficMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "tapDropsPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reconcileStaleSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "watchErrorsPerMinute": {
              "type": "number",
              "minimum": 0
            },
            "apiThrottleP99Seconds": {
              "type": "number",
              "minimum": 0
            },
            "podRestartsPerHour": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "streaming": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "viewerDropsPerSecond": {
              "type": "number",
              "minimum": 0
            },
            "relayReconnectsPerSecond": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "additionalProperties": false
    },
    "drainTimeout": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m))+$",
      "description": "How long a stopping flow runtime may take to finish in-flight frames and flush sinks"
    },
    "kubeClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "burst": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
