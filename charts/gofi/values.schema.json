{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "listenerPodTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "image"
            ]
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "volumeMounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "mountPath"
            ]
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "framing",
          "parser"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "source": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "listen": {
                "type": "object"
              }
            }
          },
          "framing": {
            "type": "object"
          },
          "parser": {
            "type": "object"
          }
        }
      }
    },
    "nodePortRange": {
      "type": "string",
      "pattern": "^$|^[0-9]+-[0-9]+$",
      "description": "NodePort range flow Services may request (min-max); empty means 30000-32767"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "clusterWide": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "manageListeners": {
          "type": "boolean"
        }
      }
    },
    "uds": {
      "type": "object",
      "properties": {
        "manageAllows": {
          "type": "boolean"
        },
        "packageBaseConfigMap": {
          "type": "string"
        }
      }
    }
  }
}
