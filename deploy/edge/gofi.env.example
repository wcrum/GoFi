# /etc/gofi/gofi.env -- environment for the gofi systemd unit on an edge host.
# Every variable is documented in docs/configuration.md. Lines are KEY=value;
# systemd does not expand $VARS here.

# Preset for 1-2 cores / <= 1 GB RAM. Override individual knobs below.
GOFI_PROFILE=edge

# Run flows inside this process (no Docker, no Kubernetes).
GOFI_DRIVER=inprocess

# Durable state lives on flash under /var/lib/gofi (StateDirectory in the unit).
GOFI_CONFIG_FILE=/var/lib/gofi/listeners.yaml
GOFI_HISTORY_DIR=/var/lib/gofi/history
GOFI_SANDBOX_CONFIG_FILE=/var/lib/gofi/sandboxes.yaml
GOFI_EXPRESSIONS_CONFIG_FILE=/var/lib/gofi/expressions.yaml

# API + UI. Bind to localhost and put it behind SSH/VPN unless the LAN is
# trusted; the UI has no authentication of its own.
INGRESS_API_ADDR=127.0.0.1:9090

# Logging: journald stores text more cheaply than JSON; raise to debug only
# while diagnosing.
GOFI_LOG_FORMAT=text
GOFI_LOG_LEVEL=info

# Memory: leave GOFI_MEMORY_LIMIT unset to inherit MemoryMax from the unit.
# GOFI_MEMORY_LIMIT=192Mi
# GOFI_GOMEMLIMIT_FRACTION=0.7

# Offline operation: keep up to 32 MiB of undelivered sink data on flash so a
# dropped uplink does not lose messages; retry up to every 2 minutes.
GOFI_SINK_SPOOL_DIR=/var/lib/gofi/spool
GOFI_SINK_SPOOL_MAX_BYTES=32Mi
GOFI_SINK_RETRY_MAX_BACKOFF=2m
GOFI_SINK_DROP_POLICY=drop-oldest

# Flash wear: few revisions, short retention.
GOFI_HISTORY_LIMIT=10
GOFI_HISTORY_DELETED_RETENTION=24h

# Sender limits for one listener. 512 idle TCP peers cost ~4 KiB each.
GOFI_MAX_CONNECTIONS=512
GOFI_IDLE_TIMEOUT=2m
GOFI_MAX_FRAME_BYTES=256Ki

# Metrics scraping over an intermittent link: aggregate less often.
GOFI_METRICS_INTERVAL=15s

# Graceful stop budget on SIGTERM (systemd TimeoutStopSec must be larger).
GOFI_DRAIN_TIMEOUT=20s
