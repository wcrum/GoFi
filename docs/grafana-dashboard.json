{
  "uid": "gofi-overview",
  "title": "GoFi traffic and operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "gofi"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {},
        "options": []
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Received frames / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (listener) (rate(gofi_frames_received_total[5m]))",
          "legendFormat": "{{listener}} {{stage}} {{sink_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Rejected messages / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (listener, stage) (rate(gofi_messages_rejected_total[5m]))",
          "legendFormat": "{{listener}} {{stage}} {{sink_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Parser errors / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (listener) (rate(gofi_parser_errors_total[5m]))",
          "legendFormat": "{{listener}} {{stage}} {{sink_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Sink dispatch failures / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (listener, sink_type) (rate(gofi_sink_dispatch_total{outcome=\"error\"}[5m]))",
          "legendFormat": "{{listener}} {{stage}} {{sink_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Sink dispatch duration p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, listener, sink_type) (rate(gofi_sink_dispatch_duration_seconds_bucket[5m])))",
          "legendFormat": "{{listener}} {{stage}} {{sink_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Source bytes / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (listener) (rate(gofi_source_bytes_total[5m]))",
          "legendFormat": "{{listener}} {{stage}} {{sink_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Pipeline logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "$loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"gofi\"} | json",
          "legendFormat": "{{listener}} {{stage}} {{sink_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
