  "patterns": [
    "^[\\p{P}\\p{S}\\s\\d]*$",
    "^\\{\\{[^}]+\\}\\}$",
    "^[a-z][a-z0-9+.-]*://",
    "^[a-z0-9_.-]+\\.(ya?ml|json|py|go|ts|tsx|proto)$",
    "^SELECT\\b",
    "^fields\\[",
    "^\\$\\.",
    "^\\{.*\\}$",
    "^-----BEGIN ",
    "^</?[a-z][a-z0-9-]*>$",
    "^\\^",
    "^[A-Za-z][A-Za-z0-9_.-]*=[A-Za-z0-9_.:/-]+$",
    "^[a-z]+[A-Z][A-Za-z0-9]*$",
    "^[a-z0-9]+([-:][a-z0-9]+)+$",
    "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
    "^[a-z0-9_-]+(/[a-z0-9_+*#-]*)+/?$",
    "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\.(>|\\*|#)$",
    "^\\*\\.[a-z0-9]+$",
    "^\\d{4}-\\d{2}-\\d{2}T",
    "^user:pass@",
    "^X-[A-Za-z0-9-]+$",
    "^[A-Z0-9]+\\.\\.\\.$"
  ]
