{
  "name": "gofi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "node e2e/run.mjs",
    "e2e:i18n": "node e2e/i18n-sweep.mjs",
    "test": "node --experimental-strip-types --test src/*.test.mjs src/components/canvas/*.test.mjs src/components/python/*.test.mjs src/components/*.test.mjs src/components/assistant/*.test.mjs src/components/tutorial/*.test.mjs src/components/function-wizard/*.test.mjs src/components/cel/*.test.mjs src/lib/*.test.mjs src/theme/*.test.mjs src/shell/*.test.mjs src/i18n/*.test.mjs scripts/*.test.mjs",
    "i18n:extract": "i18next -c i18next-parser.config.mjs",
    "i18n:check": "node scripts/i18n-check.mjs --allow-missing",
    "i18n:check:strict": "node scripts/i18n-check.mjs",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "verify": "node scripts/i18n-lint.mjs --strict && node scripts/i18n-check.mjs --allow-missing && node --run test",
    "prebuild": "node scripts/copy-grafana-assets.mjs",
    "predev": "node scripts/copy-grafana-assets.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@emotion/css": "^11.13.5",
    "@grafana/data": "13.2.4",
    "@grafana/i18n": "13.2.4",
    "@grafana/ui": "13.2.4",
    "@xyflow/react": "12.12.0",
    "i18next": "26.4.6",
    "monaco-editor": "0.34.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.18",
    "react-icons": "^5.7.0",
    "react-router-dom-v5-compat": "^6.30.6",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.74.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "i18next-parser": "^9.4.0",
    "playwright-core": "^1.49.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
